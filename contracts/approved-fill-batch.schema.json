{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://piko.local/schemas/approved-fill-batch.schema.json",
  "title": "ApprovedFillBatch",
  "description": "Step 6 runtime grant. Worker-generated, exact tab/document/scan/form-bound, one use, at most 10 seconds. Runtime checks enforce freshness, uniqueness and live DOM eligibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tabId",
    "scanId",
    "documentId",
    "origin",
    "batchId",
    "issuedAt",
    "expiresAt",
    "items"
  ],
  "properties": {
    "tabId": {
      "type": "integer",
      "minimum": 0
    },
    "scanId": {
      "type": "string",
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "maxLength": 64
    },
    "documentId": {
      "type": "string",
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "maxLength": 64
    },
    "origin": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https?://[^/]+$"
    },
    "batchId": {
      "type": "string",
      "pattern": "^[a-z]+_[a-f0-9]{32}$",
      "maxLength": 64
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 0
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fieldId",
          "formId",
          "target",
          "overwriteExisting"
        ],
        "properties": {
          "fieldId": {
            "type": "string",
            "pattern": "^[a-z]+_[a-f0-9]{32}$",
            "maxLength": 64
          },
          "formId": {
            "type": "string",
            "pattern": "^[a-z]+_[a-f0-9]{32}$",
            "maxLength": 64
          },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "text",
                      "email",
                      "tel",
                      "number",
                      "date",
                      "textarea"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 1024
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "optionId"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "select",
                      "radio"
                    ]
                  },
                  "optionId": {
                    "type": "string",
                    "pattern": "^[a-z]+_[a-f0-9]{32}$",
                    "maxLength": 64
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "checked"
                ],
                "properties": {
                  "kind": {
                    "const": "checkbox"
                  },
                  "checked": {
                    "type": "boolean"
                  }
                }
              }
            ]
          },
          "overwriteExisting": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
